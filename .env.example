# Copy to .env.local for development. In production set these in your host
# (e.g. Vercel → Project → Settings → Environment Variables).

# --- required -------------------------------------------------------------
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- database ----------------------------------------------------------------
# Leave empty locally → SQLite file at ./data/zykson.db
# On Vercel you can instead connect Turso under Storage — it sets
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, which are also accepted.
# Production (free): Turso — https://turso.tech
#   turso db create zykson && turso db show zykson --url && turso db tokens create zykson
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- media storage (pick ONE for production; local disk is used otherwise) --
# Vercel Blob (Vercel → Storage → Blob → connect to project sets this for you)
BLOB_READ_WRITE_TOKEN=
# …or any S3-compatible bucket, e.g. Cloudflare R2 (10 GB free, no egress fees)
S3_BUCKET=
S3_ENDPOINT=            # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=          # public bucket URL / custom domain, e.g. https://media.yourdomain.com

# --- optional ---------------------------------------------------------------
# Time zone used for dates on the site
NEXT_PUBLIC_TIMEZONE=Africa/Lagos
# Local seed login (pnpm seed) — dev only
SEED_ADMIN_EMAIL=author@example.com
SEED_ADMIN_PASSWORD=
